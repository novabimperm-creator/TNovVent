<Window x:Class="TNovVent.DTCWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovVent"
        mc:Ignorable="d"
        Width="420"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:DTCViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СТЕНКИ КЛАССЫ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Margin="0,12,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathTextBox"
                         Grid.Column="0"
                         Text="{Binding filePath}"
                         Height="36"
                         Margin="0,0,8,0"
                         IsReadOnly="True"
                         Style="{StaticResource DarkTextBoxStyle}"/>
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="Обзор..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="90"
                        Padding="10,6"
                        Click="BrowseButton_Click"/>
            </Grid>

            <TextBlock Text="Выберите сценарий работы"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,8"/>

            <RadioButton x:Name="rB1"
                         GroupName="elems"
                         Style="{StaticResource CardRadioStyle}"
                         IsChecked="{Binding all}">
                <TextBlock Text="Все элементы" Style="{StaticResource CardTitleStyle}"/>
            </RadioButton>
            <RadioButton x:Name="rB2"
                         GroupName="elems"
                         Style="{StaticResource CardRadioStyle}"
                         IsChecked="{Binding visible}"
                         Margin="0,0,0,10">
                <TextBlock Text="Выбранные элементы" Style="{StaticResource CardTitleStyle}"/>
            </RadioButton>

            <Button Content="Применить"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="acceptButton"
                    IsDefault="True"
                    Click="acceptButton_Click"/>
            <Button Content="Отмена"
                    Style="{StaticResource CloseButtonStyle}"
                    x:Name="escButton"
                    IsCancel="True"
                    Click="escButton_Click"/>
        </StackPanel>
    </Border>
</Window>
