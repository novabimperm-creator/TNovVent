<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{EDA54D6B-E20D-410B-A88F-2B02194D9A54}</ProjectGuid>
    <RootNamespace>TNovVent</RootNamespace>
    <AssemblyName>TNovVent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Excel interop: на net48 из GAC со встраиванием типов, на .NET 10 — из NuGet. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.Office.Interop.Excel">
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <SpecificVersion>False</SpecificVersion>
      <HintPath>C:\Windows\assembly\GAC_MSIL\Microsoft.Office.Interop.Excel\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Excel.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001">
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TNovCommon\TNovCommon.csproj" Private="false" />
    <ProjectReference Include="..\TNovMEPSpec\TNovMEPSpec.csproj" Private="false" />
  </ItemGroup>

  <!-- ===== Расчёт теплопотерь (папка Heatloss) ===== -->
  <!-- Отчёт собирается ClosedXML, а не Excel Interop: расчёт выгружает книгу
       на машине без установленного Excel и без запуска COM-сервера.
       RBush — пространственный индекс для поиска конструкций по геометрии. -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="RBush.Signed" Version="4.0.0" />
  </ItemGroup>

  <!-- ZipArchive для запасной сборки книги .xlsx (SimpleXlsxWriter): формат — это
       zip с XML, и записать его можно средствами самого .NET, без ClosedXML.
       Нужно там, где библиотек оформления рядом с плагином не оказалось.
       На net48 System.IO.Compression в неявный набор ссылок не входит; на .NET 10
       она часть платформы, и явная ссылка там не нужна. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- Нормативные каталоги вшиты в сборку. Имена ресурсов заданы ЯВНО: по умолчанию
       SDK составил бы их из RootNamespace (TNovVent) и пути к папке, а код читает
       их по историческим именам QOVETER.Resources.* — те же имена стоят в тестах
       и в документации проекта. Переименование здесь молча вернуло бы fallback
       на два города с нулевыми температурами и пустой каталог СП 230. -->
  <!-- Include, а НЕ Update: в SDK-проекте .json в стандартную выборку
       EmbeddedResource не входит, а Update только правит уже включённый элемент.
       С Update сборка проходит молча, и оба каталога просто не попадают в DLL:
       CityService откатывается на два города с нулевыми температурами,
       SP230Catalog оказывается пустым и мостики холода не считаются вовсе.
       Сторож — проверка имён ресурсов после сборки. -->
  <ItemGroup>
    <EmbeddedResource Include="Heatloss\Resources\Cities.json"
                      LogicalName="QOVETER.Resources.Cities.json" />
    <EmbeddedResource Include="Heatloss\Resources\SP230Bridges.json"
                      LogicalName="QOVETER.Resources.SP230Bridges.json" />
  </ItemGroup>

  <!-- ===== Версионирование ===== -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateVersion.ps1&quot;" />
  </Target>

</Project>
