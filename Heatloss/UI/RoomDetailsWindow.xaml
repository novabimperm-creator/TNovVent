<Window x:Class="QOVETER.UI.RoomDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детальная информация" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    
    <Window.Resources>
        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,10,5"/>
            <Setter Property="Width" Value="180"/>
        </Style>
        
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <TabControl>
            <TabItem Header="Общая информация">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <!-- Основные параметры помещения -->
                        <Border Style="{StaticResource DetailCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОСНОВНЫЕ ПАРАМЕТРЫ" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="RoomNameText" Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    
                                    <TextBlock Text="Тип помещения:" Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="RoomTypeText" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    
                                    <TextBlock Text="Площадь:" Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="RoomAreaText" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    
                                    <TextBlock Text="Ориентация:" Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="RoomOrientationText" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    
                                    <TextBlock Text="Этаж:" Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="RoomLevelText" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Теплопотери -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ТЕПЛОПОТЕРИ" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Через стены:" Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="WallLossText" Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <TextBlock Text="Через окна:" Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="WindowLossText" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <TextBlock Text="Через двери:" Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="DoorLossText" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <TextBlock Text="Через пол:" Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="FloorLossText" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <!-- Кровля показывается наравне с полом: на верхнем
                                         этаже это крупнейшая составляющая Q_огр, а строки
                                         для неё в окне не было вовсе — слагаемые не сходились
                                         с итогом, и понять почему было нельзя. -->
                                    <TextBlock Text="Через кровлю:" Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="RoofLossText" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <TextBlock Text="Вентиляционные:" Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="VentLossText" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <TextBlock Text="Итого (Q огр + Q вент):" Grid.Row="6" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="SubtotalLossText" Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>

                                    <TextBlock Text="С запасом:" Grid.Row="7" Grid.Column="0" Style="{StaticResource DetailLabelStyle}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TotalLossText" Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValueStyle}" FontWeight="Bold" Foreground="#E74C3C"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Ограждающие конструкции">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <!-- Стены -->
                        <Border Style="{StaticResource DetailCardStyle}">
                            <StackPanel>
                                <TextBlock Text="СТЕНЫ" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <!-- Источник строк — EnclosureRow (code-behind): все
                                     подписи собираются там, включая R, «за стеной»
                                     (с температурой лоджии из баланса) и источник U.
                                     Это ответ на вопросы проектировщика 2026-10-07:
                                     «почему у одинаковых стен разные U», «почему окна
                                     теряют мало», «добавить R по конструкциям». -->
                                <ItemsControl x:Name="WallsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"/>
                                                    <Grid Margin="10,2,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Площадь:" Grid.Row="0" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding AreaText}" Grid.Row="0" Grid.Column="1" Margin="5,0,10,0"/>

                                                        <TextBlock Text="U:" Grid.Row="0" Grid.Column="2" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding UText}" Grid.Row="0" Grid.Column="3" Margin="5,0,10,0"/>

                                                        <TextBlock Text="R:" Grid.Row="0" Grid.Column="4" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding RText}" Grid.Row="0" Grid.Column="5" Margin="5,0,0,0"/>

                                                        <TextBlock Text="За стеной:" Grid.Row="1" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding BehindText}" Grid.Row="1" Grid.Column="1" Margin="5,0,10,0" FontWeight="SemiBold"/>

                                                        <TextBlock Text="Ориентация:" Grid.Row="1" Grid.Column="2" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding OrientationText}" Grid.Row="1" Grid.Column="3" Margin="5,0,10,0"/>

                                                        <TextBlock Text="U из:" Grid.Row="2" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding SourceText}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Margin="5,0,0,0" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        
                        <!-- Окна -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ОКНА" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <ItemsControl x:Name="WindowsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"/>
                                                    <Grid Margin="10,2,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Площадь:" Grid.Row="0" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding AreaText}" Grid.Row="0" Grid.Column="1" Margin="5,0,10,0"/>

                                                        <TextBlock Text="U:" Grid.Row="0" Grid.Column="2" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding UText}" Grid.Row="0" Grid.Column="3" Margin="5,0,10,0"/>

                                                        <TextBlock Text="Тип:" Grid.Row="0" Grid.Column="4" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding ExtraText}" Grid.Row="0" Grid.Column="5" Margin="5,0,0,0"/>

                                                        <TextBlock Text="За окном:" Grid.Row="1" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding BehindText}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5,0,10,0" FontWeight="SemiBold"/>

                                                        <TextBlock Text="Ориентация:" Grid.Row="1" Grid.Column="4" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding OrientationText}" Grid.Row="1" Grid.Column="5" Margin="5,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        
                        <!-- Двери -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ДВЕРИ" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <ItemsControl x:Name="DoorsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"/>
                                                    <Grid Margin="10,2,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Площадь:" Grid.Row="0" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding AreaText}" Grid.Row="0" Grid.Column="1" Margin="5,0,10,0"/>

                                                        <TextBlock Text="U:" Grid.Row="0" Grid.Column="2" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding UText}" Grid.Row="0" Grid.Column="3" Margin="5,0,10,0"/>

                                                        <TextBlock Text="Материал:" Grid.Row="0" Grid.Column="4" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding ExtraText}" Grid.Row="0" Grid.Column="5" Margin="5,0,0,0"/>

                                                        <TextBlock Text="За дверью:" Grid.Row="1" Grid.Column="0" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding BehindText}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="5,0,0,0" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Коэффициенты">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource DetailCardStyle}">
                            <StackPanel>
                                <TextBlock Text="КОЭФФИЦИЕНТЫ β" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <ItemsControl x:Name="CoefficientsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Text="{Binding Key}" Grid.Column="0"/>
                                                    <TextBlock Text="{Binding Value, StringFormat=F3}" Grid.Column="1" Foreground="#E74C3C"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock x:Name="TotalCoefficientText" 
                                           FontWeight="Bold" 
                                           Margin="0,10,0,0" 
                                           Foreground="#2C3E50"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ТЕПЛОТЕХНИЧЕСКИЕ ХАРАКТЕРИСТИКИ" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Это 1/U_avg = ΣA / Σ(U·A), а не среднее R: для
                                         неоднородной стены величины различаются, и подпись
                                         «Среднее R стен» вводила в заблуждение. Формулы
                                         выписаны прямо в окно: вопрос «как посчитал?»
                                         от проектировщика 2026-10-07 — ровно про эти
                                         две строки, и отвечать на него должен UI,
                                         а не переписка. -->
                                    <TextBlock Text="1/U средневзвеш.:" Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="AverageRText" Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#95A5A6" FontSize="11" Margin="0,-3,0,6" TextWrapping="Wrap"
                                               Text="= ΣA / Σ(U·A) по наружным стенам помещения (площади нетто, без окон и дверей). Это НЕ среднее R: доли стен взвешены по тепловому потоку."/>

                                    <TextBlock Text="Коэфф. теплопотерь:" Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="HeatLossCoefficientText" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#95A5A6" FontSize="11" Margin="0,-3,0,6" TextWrapping="Wrap"
                                               Text="= Σ(U·A) / ΣA — средневзвешенное U стен, обратная величина строки выше."/>

                                    <TextBlock Text="Удельная нагрузка:" Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock x:Name="SpecificLoadText" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValueStyle}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Foreground="#95A5A6" FontSize="11" Margin="0,-3,0,0" TextWrapping="Wrap"
                                               Text="= Q с запасом / площадь помещения."/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>