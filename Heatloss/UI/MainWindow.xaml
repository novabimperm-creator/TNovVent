<Window x:Class="QOVETER.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QOVETER - Расчет теплопотерь по ГОСТ 30494-96" 
        Height="850" Width="1500"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#FFF4F6F9"
        FontFamily="Segoe UI, Tahoma, Geneva, Verdana, sans-serif">
    
    <Window.Resources>
        <!-- Стили -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#FF27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RevitButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#FF0A7B9B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0C9ECA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFD1D8E0"/>
            <Setter Property="Foreground" Value="#FF2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF2C3E50"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD1D8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF0F0F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFD1D8E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFD1D8E0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF4F6F9"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <!-- ЛЕВАЯ ПАНЕЛЬ: Настройки и помещения -->
        <Border Grid.Column="0" Background="White" BorderBrush="#FFD1D8E0" BorderThickness="0,0,1,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Text="QOVETER" FontSize="24" FontWeight="Bold" Foreground="#FF2C3E50" Margin="0,0,0,15"/>
                
                <!-- Параметры -->
                <GroupBox Grid.Row="1" Header="Параметры среды">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="t внутр:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="InternalTempBox" Text="20" VerticalAlignment="Center" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="°C" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#FF7F8C8D"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="t наруж:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="ExternalTempBox" Text="-25" VerticalAlignment="Center" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="°C" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#FF7F8C8D"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Плотность:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="OccupancyDensityBox" Text="20.0" VerticalAlignment="Center" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="м²/чел" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#FF7F8C8D"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="SafetyFactorCheck" Content="Запас" IsChecked="True" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" x:Name="SafetyFactorBox" Text="0" VerticalAlignment="Center" TextAlignment="Right" Margin="5,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="%" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="#FF7F8C8D"/>
                        </Grid>
                        <CheckBox x:Name="DetailedCalcCheck" Content="Детальный расчет" IsChecked="True" FontWeight="Normal"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Город -->
                <GroupBox Grid.Row="2" Header="Климатические данные">
                    <StackPanel>
                        <ComboBox x:Name="CitiesCombo" DisplayMemberPath="Name" Height="28"/>
                        <TextBlock x:Name="CityInfoText" Margin="0,5,0,10" TextWrapping="Wrap" FontSize="11" Foreground="#FF7F8C8D"/>
                        <Button x:Name="SettingsButton" Content="⚙ Настройки ориентации..." Height="30" Click="SettingsButton_Click" Style="{StaticResource ButtonStyle}" Background="#FF34495E" Padding="10,2"/>
                        <Button x:Name="RoomTempSettingsButton" Content="🌡 Температуры по комнатам..." Height="30" Margin="0,5,0,0" Click="RoomTempSettingsButton_Click" Style="{StaticResource ButtonStyle}" Background="#FF34495E" Padding="10,2"/>
                        <Button x:Name="NodeSettingsButton" Content="🧱 Узлы фасада (по объекту)..." Height="30" Margin="0,5,0,0" Click="NodeSettingsButton_Click" Style="{StaticResource ButtonStyle}" Background="#FF34495E" Padding="10,2" ToolTip="Положение оконной рамы относительно утеплителя, нахлёст, зуб, перфорация плиты. Из модели не читаются — это чертёж узла. Файл кладётся рядом с моделью: на другом объекте узел будет другим. Пока не задано, СП-каталог берёт худший вариант по потерям."/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Помещения -->
                <GroupBox Grid.Row="3" Header="Выбор помещений">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="SelectedRoomsCountText" Text="Выбрано: 0" FontWeight="Bold" Foreground="#FF2980B9" Margin="0,0,10,0"/>
                            <TextBlock x:Name="RoomCountText" Text="Всего: 0" Foreground="#FF7F8C8D"/>
                        </StackPanel>
                        
                        <ListBox Grid.Row="1" x:Name="RoomsListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#FFD1D8E0" Margin="0,0,0,10" Background="White" Foreground="Black"/>
                        
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SelectAllButton" Grid.Column="0" Content="Выбрать все" Click="SelectAllButton_Click" Style="{StaticResource ButtonStyle}" Background="#FF95A5A6" Padding="5"/>
                            <Button x:Name="DeselectAllButton" Grid.Column="2" Content="Снять все" Click="DeselectAllButton_Click" Style="{StaticResource ButtonStyle}" Background="#FF95A5A6" Padding="5"/>
                        </Grid>
                    </Grid>
                </GroupBox>
                
                <!-- Действия -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <Button x:Name="LoadDataButton" Content="Собрать помещения" Height="38" Margin="0,0,0,8" Click="RefreshButton_Click" Style="{StaticResource ButtonStyle}"/>
                    <!-- Кнопка ничего не собирает и не влияет на расчёт: это read-only
                         обзор типов стен/окон/дверей модели. Стены и окна помещений
                         собираются кнопкой «Собрать помещения». -->
                    <Button x:Name="ModelAuditButton" Content="🔍 Аудит модели" Height="35" Margin="0,0,0,8" Click="ModelAudit_Click" Style="{StaticResource ButtonStyle}" Background="#FF8E44AD" ToolTip="Справочный обзор типов стен, окон и дверей модели. На расчёт не влияет."/>
                    <Button x:Name="CalculateButton" Content="⚡ Рассчитать теплопотери" Height="45" Margin="0,0,0,8" Click="CalculateAll_Click" Style="{StaticResource PrimaryButtonStyle}" FontSize="15"/>
                    <TextBlock x:Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#FF7F8C8D" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ЦЕНТРАЛЬНАЯ ПАНЕЛЬ: План -->
        <Border Grid.Column="1" Background="#FFF8F9FA" BorderBrush="#FFD1D8E0" BorderThickness="0,0,1,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="План этажа" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LevelsCombo" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center" Height="28"/>
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="#FFD1D8E0" BorderThickness="1" Background="White" CornerRadius="6" Padding="2" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="PlanScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PanningMode="Both">
                            <Canvas x:Name="FloorPlanCanvas" Background="White"
                                    Width="2000" Height="2000"
                                    MouseWheel="FloorPlanCanvas_MouseWheel"/>
                        </ScrollViewer>
                        <TextBlock x:Name="NoRoomsText" Text="Модель не загружена"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FF95A5A6" FontSize="14"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="FloorPlanTitle" Text="Все этажи"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   FontSize="12" Foreground="#FF7F8C8D" Margin="8,4"
                                   IsHitTestVisible="False"/>

                        <!-- Легенда поверх холста, а не внутри него: дочерний элемент
                             Canvas масштабировался бы вместе с планом при зуме. -->
                        <Border x:Name="LegendPanel"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="10" Padding="10,8"
                                Background="#F2FFFFFF" BorderBrush="#FFD1D8E0"
                                BorderThickness="1" CornerRadius="6"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF2C3E50" BlurRadius="10"
                                                  ShadowDepth="1" Opacity="0.13"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="ТИПЫ ПОМЕЩЕНИЙ" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="#FF95A5A6" Margin="0,0,0,6"/>
                                <StackPanel x:Name="LegendItems"/>
                                <TextBlock x:Name="ExcludedHint" FontSize="10.5" Foreground="#FF95A5A6"
                                           Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Подсказка по управлению планом -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="10" Padding="8,4"
                                Background="#E6FFFFFF" BorderBrush="#FFE1E6EB"
                                BorderThickness="1" CornerRadius="4"
                                IsHitTestVisible="False">
                            <TextBlock Text="Ctrl + колесо — масштаб · клик — выбрать помещение"
                                       FontSize="10.5" Foreground="#FF95A5A6"/>
                        </Border>
                        <StackPanel x:Name="SelectLevelHintPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="📐" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Для отображения графического плана"
                                       HorizontalAlignment="Center" FontSize="15"
                                       Foreground="#FF34495E" FontWeight="SemiBold"/>
                            <TextBlock Text="выберите конкретный этаж в списке выше ↑"
                                       HorizontalAlignment="Center" FontSize="13"
                                       Foreground="#FF7F8C8D" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
        <!-- ПРАВАЯ ПАНЕЛЬ: Результаты -->
        <Border Grid.Column="2" Background="White" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Результаты расчета" FontSize="20" FontWeight="Bold" Foreground="#FF2C3E50" Margin="0,0,0,15"/>
                <TextBlock Grid.Row="1" x:Name="ResultsSummary" Text="Готов к расчету" Margin="0,0,0,15" Foreground="#FF34495E" FontSize="14"/>
                
                <DataGrid Grid.Row="2" x:Name="ResultsDataGrid" Margin="0,0,0,15" MouseDoubleClick="ResultsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="2*"/>
                        <DataGridTextColumn Header="Кв." Binding="{Binding Apartment}" Width="0.7*"/>
                        <DataGridTextColumn Header="Этаж" Binding="{Binding FloorNumber}" Width="*"/>
                        <DataGridTextColumn Header="S (м²)" Binding="{Binding Area, StringFormat={}{0:F1}}" Width="*"/>
                        <DataGridTextColumn Header="Qогр (Вт)" Binding="{Binding Q_ogr, StringFormat={}{0:F0}}" Width="*"/>
                        <DataGridTextColumn Header="Qвент (Вт)" Binding="{Binding Q_vent, StringFormat={}{0:F0}}" Width="*"/>
                        <DataGridTextColumn Header="Qвн (Вт)" Binding="{Binding Q_vn, StringFormat={}{0:F0}}" Width="*"/>
                        <!-- Подписи совпадают с Excel-отчётом. Раньше единственная колонка
                             называлась «Qитого», но привязана была к Q_final (С ЗАПАСОМ),
                             тогда как «Q итого» в Excel — это Q_total без запаса. Одна
                             подпись означала две разные величины, и инженеру приходилось
                             держать в голове обходной путь из CLAUDE.md. -->
                        <DataGridTextColumn Header="Qитого (Вт)" Binding="{Binding Q_total, StringFormat={}{0:F0}}" Width="1.2*"/>
                        <DataGridTextColumn Header="Q с запасом (Вт)" Binding="{Binding Q_final, StringFormat={}{0:F0}}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#FFC0392B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sстен.нар (м²)" Binding="{Binding ExtWallsArea, StringFormat={}{0:F1}}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF8E44AD"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sокон (м²)" Binding="{Binding ExtWindowsArea, StringFormat={}{0:F2}}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF2980B9"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Экспорт и Запись в Revit -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="ExportButton" Content="📊 Excel" Width="120" Height="40" Margin="0,0,10,0" Click="Export_Click" Style="{StaticResource ButtonStyle}" Background="#FF8E44AD"/>
                        <!-- Выгрузка входных данных для регрессионных тестов (см. QOVETER.Tests) -->
                        <Button x:Name="FixtureButton" Content="🧪 Фикстура" Width="130" Height="40" Margin="0,0,15,0" Click="ExportFixture_Click" Style="{StaticResource ButtonStyle}" Background="#FF16A085"
                                ToolTip="Выгрузить собранные помещения в JSON — эталонные входные данные для автотестов расчёта без Revit"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#FFF0F5F9" BorderBrush="#FFBDC3C7" BorderThickness="1" CornerRadius="6" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="Интеграция с Revit" FontWeight="Bold" Foreground="#FF0A7B9B" Margin="0,0,0,5"/>
                                <!-- Расчёт ведётся в АР-файле, поэтому пишем в помещения;
                                     пространства (Space) — запасной путь для ОВ-модели. -->
                                <TextBlock Text="Запись Q в помещения (Room) активной модели" FontSize="11" Foreground="#FF7F8C8D"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Параметр:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="RevitParameterNameBox" Text="N_Теплопотери" Width="160" Height="28" VerticalAlignment="Center" Padding="5,2" BorderBrush="#FFBDC3C7"/>
                            </StackPanel>
                            
                            <Button Grid.Column="2" x:Name="WriteToRevitButton" Content="Записать Q в Revit" Height="40" Width="170" Margin="15,0,0,0" Click="WriteToRevit_Click" Style="{StaticResource RevitButtonStyle}" ToolTip="Записать Q с запасом (Q_final) в выбранный параметр помещений активной модели. Если помещений в документе нет — в пространства (Space) ОВ-модели"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>