<Window x:Class="QOVETER.UI.RoomTemperaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расчётные температуры помещений"
        Height="620" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="TempBox">
            <Setter Property="Width"              Value="70"/>
            <Setter Property="Height"             Value="28"/>
            <Setter Property="TextAlignment"      Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="BorderBrush"        Value="#BDC3C7"/>
            <Setter Property="BorderThickness"    Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Расчётные температуры внутреннего воздуха"
                       FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="ГОСТ 30494-2011 Таблица 1 (холодный период, нижняя граница оптимальной)"
                       FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Таблица -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Шапка -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Тип помещения"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="t вн, °C"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="#555" HorizontalAlignment="Center"/>
                </Grid>

                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,6"/>

                <!-- DataGrid -->
                <DataGrid x:Name="TempGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="None"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFEFF"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- Название -->
                        <DataGridTextColumn Header="Тип"
                                           Binding="{Binding Label}"
                                           Width="*"
                                           IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding"           Value="4,6"/>
                                    <Setter Property="FontSize"          Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Температура (редактируемая) -->
                        <DataGridTextColumn Header="°C"
                                           Binding="{Binding Temperature, StringFormat='{}{0:F0}'}"
                                           Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment"   Value="Center"/>
                                    <Setter Property="FontSize"            Value="14"/>
                                    <Setter Property="FontWeight"          Value="SemiBold"/>
                                    <Setter Property="Foreground"          Value="#2980B9"/>
                                    <Setter Property="Padding"             Value="4,6"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextAlignment"      Value="Center"/>
                                    <Setter Property="FontSize"           Value="14"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка сброса -->
        <Button Grid.Row="2"
                x:Name="ResetButton"
                Content="↺  Сбросить к значениям ГОСТ 30494"
                HorizontalAlignment="Left"
                Height="30" Margin="0,12,0,0"
                Padding="10,0"
                FontSize="12"
                Foreground="#7F8C8D"
                Background="Transparent"
                BorderBrush="#BDC3C7"
                Click="ResetButton_Click"/>

        <!-- OK / Отмена -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelBtn"
                    Content="Отмена"
                    Width="100" Height="35"
                    Margin="0,0,10,0"
                    Click="CancelBtn_Click"/>
            <Button x:Name="OkBtn"
                    Content="Применить"
                    Width="110" Height="35"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="OkBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
